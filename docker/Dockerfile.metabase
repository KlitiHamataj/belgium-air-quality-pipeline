# Metabase with the MotherDuck DuckDB driver.
#
# Debian-based on purpose: the DuckDB JDBC driver needs glibc, so the official
# Alpine `metabase/metabase` image cannot load it.
#
# Keep DUCKDB_DRIVER_VERSION's DuckDB in step with `duckdb==` in requirements.txt:
# driver 1.5.3.0 bundles DuckDB 1.5.3, which reads the files this pipeline writes.
FROM eclipse-temurin:21-jre-jammy

ARG METABASE_VERSION=0.61.21
ARG DUCKDB_DRIVER_VERSION=1.5.3.0

ENV MB_PLUGINS_DIR=/home/metabase/plugins/

RUN groupadd -r metabase && useradd -r -g metabase metabase \
    && apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/metabase/plugins /metabase-data \
    && chown -R metabase:metabase /home/metabase /metabase-data

WORKDIR /home/metabase
ADD --chown=metabase:metabase --chmod=644 \
    https://downloads.metabase.com/v${METABASE_VERSION}/metabase.jar /home/metabase/
ADD --chown=metabase:metabase --chmod=644 \
    https://github.com/motherduckdb/metabase_duckdb_driver/releases/download/${DUCKDB_DRIVER_VERSION}/duckdb.metabase-driver.jar \
    /home/metabase/plugins/

EXPOSE 3000
USER metabase

CMD ["java", "-jar", "/home/metabase/metabase.jar"]
